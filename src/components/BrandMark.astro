---
interface Props {
  variant?: 'lockup' | 'mark';
  class?: string;
  decorative?: boolean;
}

const { variant = 'mark', class: className, decorative = false } = Astro.props;
const a11yProps = decorative
  ? { 'aria-hidden': 'true' as const }
  : { role: 'img' as const, 'aria-label': 'Stravin' };
---

{
  variant === 'lockup' ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 360 100"
      class={className}
      {...a11yProps}
    >
      <g>
        <path
          d="M 67 6 H 32 L 8 24 V 45 L 40 69 H 60 L 65 65.25 L 24 34.5 L 38 24 H 67 Z"
          fill="var(--mark-top)"
        />
        <path
          d="M 40 31 H 60 L 92 55 V 76 L 68 94 H 8 V 76 H 62 L 76 65.5 L 35 34.75 Z"
          fill="var(--mark-bottom)"
        />
        <rect x="74" y="6" width="18" height="18" fill="var(--mark-anchor)" />
      </g>
      <text
        x="116"
        y="66"
        fill="currentColor"
        font-family="var(--font-wordmark)"
        font-size="48"
        font-weight="600"
        letter-spacing="0.16em"
      >
        STRAVIN
      </text>
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 100 100"
      class={className}
      {...a11yProps}
    >
      <path
        d="M 67 6 H 32 L 8 24 V 45 L 40 69 H 60 L 65 65.25 L 24 34.5 L 38 24 H 67 Z"
        fill="var(--mark-top)"
      />
      <path
        d="M 40 31 H 60 L 92 55 V 76 L 68 94 H 8 V 76 H 62 L 76 65.5 L 35 34.75 Z"
        fill="var(--mark-bottom)"
      />
      <rect x="74" y="6" width="18" height="18" fill="var(--mark-anchor)" />
    </svg>
  )
}
